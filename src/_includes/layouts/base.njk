<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <script>document.documentElement.classList.add("js");</script>
  {#- Ссылки из писем админки (приглашение, сброс пароля) обрабатываем здесь: окно Netlify Identity откроется на этой странице, после входа — в /admin/ #}
  <script>window.__idToken=/(invite|recovery|confirmation)_token/.test(location.hash);if(__idToken)document.write('<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"><\/script>');</script>
  <script>if(window.__idToken&&window.netlifyIdentity)netlifyIdentity.on("login",function(){location.href="/admin/"});</script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {%- set pageTitle = (title + " — " + site.name + ", тюнинг в Алматы") if title else (site.fullName + " в Алматы") %}
  {%- set pageDesc = description or short or site.description %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta name="theme-color" content="#0a0a0b">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/og.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/unbounded-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/manrope-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css">
  {%- if page.url == "/" and home.heroSet %}
  <link rel="preload" as="image" href="{{ home.heroSet }}bg-desktop.webp" imagesrcset="{{ home.heroSet }}bg-desktop-1920.webp 1920w, {{ home.heroSet }}bg-desktop.webp 3840w" imagesizes="max(100vw, 177.8vh)" media="(min-width: 768px)" fetchpriority="high">
  <link rel="preload" as="image" href="{{ home.heroSet }}bg-mobile.webp" imagesrcset="{{ home.heroSet }}bg-mobile-1200.webp 1200w, {{ home.heroSet }}bg-mobile.webp 2400w" imagesizes="100vw" media="(max-width: 767px)" fetchpriority="high">
  <link rel="preload" as="image" href="{{ home.heroSet }}car-mobile.webp" imagesrcset="{{ home.heroSet }}car-mobile-1200.webp 1200w, {{ home.heroSet }}car-mobile.webp 2400w" imagesizes="100vw" media="(max-width: 767px)" fetchpriority="high">
  {%- endif %}
  {% block head %}{% endblock %}
  {%- if site.metrikaId %}
  <script>
    (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();
    k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
    (window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");
    ym({{ site.metrikaId }},"init",{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});
  </script>
  {%- endif %}
</head>
<body data-metrika="{{ site.metrikaId }}" class="{{ bodyClass }}">
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/modal.njk" %}
  <script src="/assets/vendor/gsap.min.js" defer></script>
  <script src="/assets/vendor/ScrollTrigger.min.js" defer></script>
  <script src="/assets/vendor/lenis.min.js" defer></script>
  <script src="/assets/js/main.js" defer></script>
</body>
</html>
